NODE_ENV=development
PORT=3001
# Set these before first production run. No default admin password exists.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-unique-long-random-password
# Used for absolute canonical links only; no domain is connected automatically.
PUBLIC_URL=https://cuktech.vn
# If 1, storefront shows demo prices disclaimer; change after editing real prices in admin.
STORE_DEMO=1
