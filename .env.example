NODE_ENV=development
PORT=3001
# Set these before first production run. No default admin password exists.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-unique-long-random-password
# Used for absolute canonical links only; no domain is connected automatically.
PUBLIC_URL=https://cuktech.vn
# If 1, storefront shows demo prices disclaimer; change after editing real prices in admin.
STORE_DEMO=1

# Import all public product metadata from cuktech.com, respecting robots.txt.
# Imported products are HIDDEN with VND price 0 and stock 0 until manually configured.
# Set 1 only after checking site terms and your rights to republish descriptions/images.
CATALOG_SYNC_ENABLED=0
# Minimum interval enforced by server: 60 minutes.
CATALOG_SYNC_HOURS=12
